@using AracGorevFormu.ViewComponents
@model List<VadeBildirimModel>

<div class="dropdown me-3">
    <button class="btn btn-link text-dark position-relative p-2 dropdown-toggle" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="text-decoration: none;">
        <i class="bi bi-bell fs-5"></i>
        @if (Model.Count > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                @Model.Count
                <span class="visually-hidden">okunmamış mesajlar</span>
            </span>
        }
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationDropdown" style="width: 350px; max-height: 400px; overflow-y: auto;">
        <li><h6 class="dropdown-header text-slate-800 fw-bold">Yaklaşan Vade Bildirimleri</h6></li>
        <li><hr class="dropdown-divider"></li>
        
        @if (Model.Count == 0)
        {
            <li><div class="dropdown-item-text text-muted small text-center py-3">Yaklaşan araç vadesi (Muayene/Sigorta) bulunmamaktadır.</div></li>
        }
        else
        {
            foreach (var bildirim in Model)
            {
                var renk = bildirim.KalanGun <= 7 ? "text-danger" : (bildirim.KalanGun <= 15 ? "text-warning" : "text-primary");
                var ikon = bildirim.VadeTipi == "Muayene" ? "bi-wrench" : "bi-shield-check";
                
                <li>
                    <a class="dropdown-item py-2" href="/Admin/Araclar">
                        <div class="d-flex align-items-start">
                            <div class="me-3 mt-1 @renk">
                                <i class="bi @ikon fs-4"></i>
                            </div>
                            <div>
                                <div class="fw-bold small text-slate-800">@bildirim.Plaka <span class="fw-normal text-muted">— @bildirim.VadeTipi</span></div>
                                <div class="small text-muted" style="white-space: normal; line-height: 1.3;">@bildirim.AracIsmi</div>
                                <div class="small mt-1 fw-bold @renk">
                                    @(bildirim.KalanGun < 0 ? $"{Math.Abs(bildirim.KalanGun)} gün gecikti!" : $"{bildirim.KalanGun} gün kaldı")
                                </div>
                            </div>
                        </div>
                    </a>
                </li>
            }
        }
    </ul>
</div>
