<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Abdurrahman Tatlıcı - Araç Görev Takip ve Filo Yönetim Sistemi" />
    <title>@ViewData["Title"] - Abdurrahman Tatlıcı Araç Görev Takip</title>
    <link rel="shortcut icon" type="image/png" href="/img/logo.png?v=4" />
    <link rel="icon" type="image/png" href="/img/logo.png?v=4" />
    <!-- Third-Party CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <!-- App Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark py-2 px-lg-4">
            <div class="container-fluid">
                <!-- Brand -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="app-brand" asp-controller="Admin" asp-action="Index">
                        <div class="app-brand-icon">
                            <i class="bi bi-truck-front-fill"></i>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="app-brand-title">Araç Görev Takip</span>
                            <span class="app-brand-subtitle">Abdurrahman Tatlıcı</span>
                        </div>
                    </a>
                }
                else
                {
                    <a class="app-brand" asp-controller="Home" asp-action="Index">
                        <div class="app-brand-icon">
                            <i class="bi bi-truck-front-fill"></i>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="app-brand-title">Araç Görev Takip</span>
                            <span class="app-brand-subtitle">Abdurrahman Tatlıcı</span>
                        </div>
                    </a>
                }

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbarCollapse" aria-controls="mainNavbarCollapse" aria-expanded="false" aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Categorized Executive Navigation Links -->
                <div class="collapse navbar-collapse" id="mainNavbarCollapse">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                        <!-- Kategori 1: Görev İşlemleri -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-nowrap" href="#" id="gorevDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-clipboard-check-fill me-1 text-amber-400"></i>Görev Talepleri
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="gorevDropdown">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Form" asp-action="Yeni">
                                        <i class="bi bi-plus-circle me-2 text-amber-400"></i>Görev Formu Doldur
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Form" asp-action="Sorgula">
                                        <i class="bi bi-search me-2 text-info"></i>Form Durumu Sorgula
                                    </a>
                                </li>
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Formlar">
                                            <i class="bi bi-card-checklist me-2 text-success"></i>Tüm Görev Formları
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Kategori 2: Filo & Bakım Yönetimi -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-nowrap" href="#" id="filoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-car-front-fill me-1 text-info"></i>Filo & Bakım
                                </a>
                                <ul class="dropdown-menu shadow" aria-labelledby="filoDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-grid-1x2-fill me-2 text-indigo-400"></i>Filo Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Araclar">
                                            <i class="bi bi-car-front me-2 text-info"></i>Araç Filosu & Ruhsatlar
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Bakimlar">
                                            <i class="bi bi-tools me-2 text-amber-400"></i>Bakım & Servis Takibi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="HgsBorc">
                                            <i class="bi bi-credit-card-2-front me-2 text-warning"></i>HGS & Ceza Sorgulama
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Kategori 3: Sistem & Ayarlar -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-nowrap" href="#" id="ayarlarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-wide-connected me-1 text-warning"></i>Sistem Ayarları
                                </a>
                                <ul class="dropdown-menu shadow" aria-labelledby="ayarlarDropdown">

                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Ayarlar" asp-route-tab="yoneticiler">
                                            <i class="bi bi-people me-2 text-primary"></i>Yönetici Hesapları
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Ayarlar" asp-route-tab="smtp">
                                            <i class="bi bi-envelope me-2 text-success"></i>E-Posta (SMTP) Bildirim
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Ayarlar" asp-route-tab="arvento">
                                            <i class="bi bi-geo-alt me-2 text-danger"></i>Arvento GPS Entegrasyonu
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="SistemKayitlari">
                                            <i class="bi bi-clock-history me-2 text-secondary"></i>Sistem Logları
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Sleek Unified User Controls Dropdown -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle border-0" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-warning fs-6 me-1"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Profil">
                                            <i class="bi bi-person-badge me-2 text-info"></i>Profilim & Şifre
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-semibold">
                                                <i class="bi bi-box-arrow-right me-2"></i>Güvenli Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm text-nowrap" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-lock-fill me-1"></i>Yönetici Girişi
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid px-lg-4 py-4 page-transition">
        @if (TempData["Mesaj"] != null)
        {
            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'success', title: '@Html.Raw(TempData["Mesaj"])',
                        showConfirmButton: false, timer: 3000, timerProgressBar: true
                    });
                });
            </script>
        }
        @if (TempData["Hata"] != null)
        {
            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'error', title: '@Html.Raw(TempData["Hata"])',
                        showConfirmButton: false, timer: 4000, timerProgressBar: true
                    });
                });
            </script>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2">
                <div>
                    <strong class="text-slate-800">Abdurrahman Tatlıcı</strong> &copy; @DateTime.Now.Year — Araç Görev Takip ve Filo Yönetim Sistemi
                </div>
            </div>
        </div>
    </footer>

    <!-- JS Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('.table-datatable').DataTable({
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json' },
                    pageLength: 25,
                    responsive: true,
                    ordering: true
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
