@model AracGorevFormu.Models.MakineBakim

@{
    ViewData["Title"] = "Yeni Bakım Ekle";
    var makineAd = ViewBag.MakineAd as string;
    var makineler = ViewBag.Makineler as List<AracGorevFormu.Models.Makine>;
}

<div class="row">
    <!-- Sol Panel: Makbuz / Önizleme -->
    <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-file-image text-primary fs-5 me-2"></i>
                    <h5 class="mb-0 fw-bold">Makbuz Önizleme</h5>
                </div>
            </div>
            <div id="previewContainerArea" class="card-body p-0 bg-light d-flex align-items-center justify-content-center" style="min-height: 500px; position: relative; overflow: hidden; flex-direction: column; cursor: pointer;" onclick="if(event.target.tagName !== 'IMG') document.getElementById('MakbuzDosya').click()" title="Resim Yüklemek İçin Tıklayın">
                <div id="noImageMessage" class="text-center text-muted p-4">
                    <i class="bi bi-cloud-arrow-up display-1 mb-3 opacity-50"></i>
                    <h5>Buraya Tıklayarak Belge Yükleyin</h5>
                    <p class="small">Birden fazla makbuz/fatura yükleyebilir ve alt kısımdan geçiş yapabilirsiniz.</p>
                </div>
                <img id="receiptPreview" src="#" alt="Makbuz Önizleme" class="img-fluid d-none mb-3" style="max-height: 80%; width: auto; object-fit: contain;" />
                
                <!-- Thumbnail Gallery -->
                <div id="thumbnailGallery" class="d-none w-100 p-2" style="background: rgba(0,0,0,0.05); position: absolute; bottom: 0; left: 0; display: flex; gap: 10px; overflow-x: auto;">
                    <!-- Thumbnails will be injected here by JS -->
                </div>

                <!-- OCR Status Container (Moved up a bit so it doesn't overlap thumbnails) -->
                <div id="ocrStatusContainer" class="d-none text-center p-3 w-100" style="background: rgba(255,255,255,0.9); position: absolute; bottom: 60px;">
                    <div id="ocrSpinner" class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                    <span id="ocrStatusText" class="fw-bold text-primary small">Yapay Zeka Resmi Analiz Ediyor...</span>
                    <div class="progress mt-2" style="height: 5px;">
                        <div id="ocrProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ Panel: Form ve OCR Çıktısı -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex align-items-center">
                <i class="bi bi-tools text-primary fs-5 me-2"></i>
                <h5 class="mb-0 fw-bold">@(string.IsNullOrEmpty(makineAd) ? "Genel Makine Bakım Ekle" : $"Yeni Bakım Ekle: {makineAd}")</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="BakimEkle" method="post" enctype="multipart/form-data" id="bakimForm">
                    
                    <div class="row g-3">
                        @if (string.IsNullOrEmpty(makineAd) && makineler != null)
                        {
                            <div class="col-md-12 mb-2">
                                <label asp-for="MakineId" class="form-label text-primary fw-bold">Bakım Yapılacak Makine <span class="text-danger">*</span></label>
                                <select asp-for="MakineId" class="form-select form-select-lg" required>
                                    <option value="">-- Makine Seçiniz --</option>
                                    @foreach (var m in makineler)
                                    {
                                        <option value="@m.Id">@m.Ad (@m.Lokasyon)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="MakineId" />
                        }

                        <div class="col-md-12">
                            <label class="form-label text-primary fw-bold"><i class="bi bi-images me-1"></i> Makbuz / Fatura Yükle (Çoklu Seçim)</label>
                            <input type="file" name="MakbuzDosyalar" id="MakbuzDosya" class="form-control" accept="image/png, image/jpeg, image/jpg" multiple />
                            <div class="form-text">Birden fazla fiş/fatura seçebilirsiniz. Veya yandaki alana tıklayarak dosya seçebilirsiniz.</div>
                        </div>
                        
                        <!-- Hidden field to store OCR text -->
                        <input type="hidden" asp-for="MakbuzMetni" id="MakbuzMetniField" />

                        <hr class="my-4 text-muted" />

                        <div class="col-md-6">
                            <label asp-for="BakimTarihi" class="form-label">Bakım Tarihi <span class="text-danger">*</span></label>
                            <input asp-for="BakimTarihi" class="form-control" type="date" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BakimTuru" class="form-label">Bakım Türü <span class="text-danger">*</span></label>
                            <select asp-for="BakimTuru" class="form-select" required>
                                <option value="Periyodik Bakım">Periyodik Bakım</option>
                                <option value="Arıza / Tamir">Arıza / Tamir</option>
                                <option value="Kurulum / Revizyon">Kurulum / Revizyon</option>
                                <option value="Kalibrasyon">Kalibrasyon</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CalismaSaati" class="form-label">Bakım Anı Çalışma Saati <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="CalismaSaati" class="form-control" type="number" min="0" required />
                                <span class="input-group-text">Saat</span>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Maliyet" class="form-label">Toplam Maliyet (TL)</label>
                            <div class="input-group">
                                <input asp-for="Maliyet" class="form-control" type="number" step="0.01" min="0" value="0" />
                                <span class="input-group-text">₺</span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="YapilanIslemler" class="form-label">Yapılan İşlemler <span class="text-danger">*</span></label>
                            <textarea asp-for="YapilanIslemler" class="form-control" rows="3" required placeholder="Örn: Motor yağı değiştirildi..."></textarea>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DegisenParcalar" class="form-label">Değişen Parçalar</label>
                            <textarea asp-for="DegisenParcalar" class="form-control" rows="2" placeholder="Örn: 2 adet x rulman..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BakimiYapan" class="form-label">Bakımı Yapan Kişi / Firma</label>
                            <input asp-for="BakimiYapan" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SonrakiBakimCalismaSaati" class="form-label">Sonraki Bakım Çalışma Saati</label>
                            <div class="input-group">
                                <input asp-for="SonrakiBakimCalismaSaati" class="form-control" type="number" min="0" />
                                <span class="input-group-text">Saat</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-end">
                        <a asp-action="@(string.IsNullOrEmpty(makineAd) ? "Index" : "BakimListesi")" asp-route-makineId="@Model.MakineId" class="btn btn-outline-secondary me-2 hover-lift">İptal</a>
                        <button type="submit" class="btn btn-primary px-4 hover-lift">
                            <i class="bi bi-save me-1"></i> Bakımı Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <!-- Tesseract.js (Frontend OCR) -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

    <script>
        document.getElementById('MakbuzDosya').addEventListener('change', async function(e) {
            var files = e.target.files;
            if (!files || files.length === 0) return;

            document.getElementById('noImageMessage').classList.add('d-none');
            const gallery = document.getElementById('thumbnailGallery');
            gallery.classList.remove('d-none');
            gallery.innerHTML = '';
            
            document.getElementById('MakbuzMetniField').value = ''; // Reset OCR
            let combinedOcrText = "";

            for(let i=0; i<files.length; i++) {
                let file = files[i];
                let reader = new FileReader();
                
                let fileDataUrl = await new Promise((resolve) => {
                    reader.onload = (e) => resolve(e.target.result);
                    reader.readAsDataURL(file);
                });

                // Create thumbnail
                let thumb = document.createElement('img');
                thumb.src = fileDataUrl;
                thumb.className = "img-thumbnail";
                thumb.style.height = "50px";
                thumb.style.cursor = "pointer";
                thumb.onclick = function(e) {
                    e.stopPropagation();
                    document.getElementById('receiptPreview').src = fileDataUrl;
                    document.getElementById('receiptPreview').classList.remove('d-none');
                };
                gallery.appendChild(thumb);

                // Show first image automatically
                if (i === 0) {
                    document.getElementById('receiptPreview').src = fileDataUrl;
                    document.getElementById('receiptPreview').classList.remove('d-none');
                }

                // OCR for this file
                let ocrResult = await startOcrProcess(fileDataUrl, i+1, files.length);
                if (ocrResult) {
                    combinedOcrText += `--- [Belge ${i+1}] ---\n${ocrResult}\n\n`;
                }
            }

            // Save combined OCR text
            document.getElementById('MakbuzMetniField').value = combinedOcrText;
            
            const yapilanIslemlerBox = document.getElementById('YapilanIslemler');
            if (yapilanIslemlerBox && yapilanIslemlerBox.value.trim() === '') {
                yapilanIslemlerBox.value = "Okunan Belgeler:\n" + combinedOcrText.substring(0, 400);
            }
        });

        async function startOcrProcess(imageData, currentIdx, totalFiles) {
            const statusContainer = document.getElementById('ocrStatusContainer');
            const statusText = document.getElementById('ocrStatusText');
            const progressBar = document.getElementById('ocrProgressBar');
            const spinner = document.getElementById('ocrSpinner');
            const yapilanIslemlerBox = document.getElementById('YapilanIslemler');
            const maliyetBox = document.getElementById('Maliyet');
            
            statusContainer.classList.remove('d-none');
            statusText.innerText = `Belge ${currentIdx}/${totalFiles} Okunuyor...`;
            statusText.className = "fw-bold text-primary small";
            progressBar.style.width = "0%";
            progressBar.className = "progress-bar progress-bar-striped progress-bar-animated bg-primary";
            spinner.classList.remove('d-none');

            try {
                const worker = await Tesseract.createWorker("tur", 1, {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            progressBar.style.width = Math.round(m.progress * 100) + "%";
                        }
                    }
                });
                
                const ret = await worker.recognize(imageData);
                const text = ret.data.text;
                
                await worker.terminate();

                if (currentIdx === totalFiles) {
                    spinner.classList.add('d-none');
                    statusText.innerText = "✅ Tüm Belgeler Okundu!";
                    statusText.className = "fw-bold text-success small";
                    progressBar.className = "progress-bar bg-success";
                    progressBar.style.width = "100%";
                    setTimeout(() => statusContainer.classList.add('d-none'), 3000);
                }

                // Price detection on the fly
                const maliyetBox = document.getElementById('Maliyet');
                const priceMatch = text.match(/(?:TOPLAM|TUTAR|ÖDENEN|TOP)\s*[:=]?\s*(\d+[.,]\d+)/i);
                if (priceMatch && priceMatch[1] && maliyetBox) {
                    let currentVal = parseFloat(maliyetBox.value || 0);
                    let detectedPrice = parseFloat(priceMatch[1].replace(',', '.'));
                    maliyetBox.value = (currentVal + detectedPrice).toFixed(2);
                }

                return text;
            } catch (err) {
                console.error("OCR Hatası:", err);
                return "";
            }
        }
    </script>
}
