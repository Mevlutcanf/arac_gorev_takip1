@model AracGorevFormu.Models.MakineBakim

@{
    ViewData["Title"] = "Yeni Bakım Ekle";
    var makineAd = ViewBag.MakineAd as string;
    var makineler = ViewBag.Makineler as List<AracGorevFormu.Models.Makine>;
}

<div class="row">
    <!-- Sol Panel: Makbuz / Önizleme -->
    <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-file-image text-primary fs-5 me-2"></i>
                    <h5 class="mb-0 fw-bold">Makbuz Önizleme</h5>
                </div>
            </div>
            <div class="card-body p-0 bg-light d-flex align-items-center justify-content-center" style="min-height: 500px; position: relative; overflow: hidden;">
                <div id="noImageMessage" class="text-center text-muted p-4">
                    <i class="bi bi-cloud-arrow-up display-1 mb-3 opacity-50"></i>
                    <h5>Henüz Bir Belge Yüklenmedi</h5>
                    <p class="small">Sağ taraftaki formdan bir makbuz/fatura yüklediğinizde önizlemesi burada görünecektir.</p>
                </div>
                <img id="receiptPreview" src="#" alt="Makbuz Önizleme" class="img-fluid d-none" style="max-height: 100%; width: auto; object-fit: contain;" />
            </div>
        </div>
    </div>

    <!-- Sağ Panel: Form ve OCR Çıktısı -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex align-items-center">
                <i class="bi bi-tools text-primary fs-5 me-2"></i>
                <h5 class="mb-0 fw-bold">@(string.IsNullOrEmpty(makineAd) ? "Genel Makine Bakım Ekle" : $"Yeni Bakım Ekle: {makineAd}")</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="BakimEkle" method="post" enctype="multipart/form-data" id="bakimForm">
                    
                    <div class="row g-3">
                        @if (string.IsNullOrEmpty(makineAd) && makineler != null)
                        {
                            <div class="col-md-12 mb-2">
                                <label asp-for="MakineId" class="form-label text-primary fw-bold">Bakım Yapılacak Makine <span class="text-danger">*</span></label>
                                <select asp-for="MakineId" class="form-select form-select-lg" required>
                                    <option value="">-- Makine Seçiniz --</option>
                                    @foreach (var m in makineler)
                                    {
                                        <option value="@m.Id">@m.Ad (@m.Lokasyon)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="MakineId" />
                        }

                        <div class="col-md-12">
                            <label class="form-label text-primary fw-bold"><i class="bi bi-receipt me-1"></i> Makbuz / Fatura Yükle</label>
                            <input type="file" name="MakbuzDosya" id="MakbuzDosya" class="form-control" accept="image/png, image/jpeg, image/jpg" />
                            <div class="form-text">Sadece Resim dosyaları (JPG, PNG) desteklenir.</div>
                        </div>

                        <hr class="my-4 text-muted" />

                        <div class="col-md-6">
                            <label asp-for="BakimTarihi" class="form-label">Bakım Tarihi <span class="text-danger">*</span></label>
                            <input asp-for="BakimTarihi" class="form-control" type="date" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BakimTuru" class="form-label">Bakım Türü <span class="text-danger">*</span></label>
                            <select asp-for="BakimTuru" class="form-select" required>
                                <option value="Periyodik Bakım">Periyodik Bakım</option>
                                <option value="Arıza / Tamir">Arıza / Tamir</option>
                                <option value="Kurulum / Revizyon">Kurulum / Revizyon</option>
                                <option value="Kalibrasyon">Kalibrasyon</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CalismaSaati" class="form-label">Bakım Anı Çalışma Saati <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="CalismaSaati" class="form-control" type="number" min="0" required />
                                <span class="input-group-text">Saat</span>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Maliyet" class="form-label">Toplam Maliyet (TL)</label>
                            <div class="input-group">
                                <input asp-for="Maliyet" class="form-control" type="number" step="0.01" min="0" value="0" />
                                <span class="input-group-text">₺</span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="YapilanIslemler" class="form-label">Yapılan İşlemler <span class="text-danger">*</span></label>
                            <textarea asp-for="YapilanIslemler" class="form-control" rows="3" required placeholder="Örn: Motor yağı değiştirildi..."></textarea>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DegisenParcalar" class="form-label">Değişen Parçalar</label>
                            <textarea asp-for="DegisenParcalar" class="form-control" rows="2" placeholder="Örn: 2 adet x rulman..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BakimiYapan" class="form-label">Bakımı Yapan Kişi / Firma</label>
                            <input asp-for="BakimiYapan" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SonrakiBakimCalismaSaati" class="form-label">Sonraki Bakım Çalışma Saati</label>
                            <div class="input-group">
                                <input asp-for="SonrakiBakimCalismaSaati" class="form-control" type="number" min="0" />
                                <span class="input-group-text">Saat</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-end">
                        <a asp-action="@(string.IsNullOrEmpty(makineAd) ? "Index" : "BakimListesi")" asp-route-makineId="@Model.MakineId" class="btn btn-outline-secondary me-2 hover-lift">İptal</a>
                        <button type="submit" class="btn btn-primary px-4 hover-lift">
                            <i class="bi bi-save me-1"></i> Bakımı Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.getElementById('MakbuzDosya').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (!file) return;

            // 1. Resim Önizleme
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('receiptPreview').src = e.target.result;
                document.getElementById('receiptPreview').classList.remove('d-none');
                document.getElementById('noImageMessage').classList.add('d-none');
            }
            reader.readAsDataURL(file);
        });
    </script>
}
