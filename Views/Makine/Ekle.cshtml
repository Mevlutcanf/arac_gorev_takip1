@model AracGorevFormu.Models.Makine

@{
    ViewData["Title"] = "Yeni Makine Ekle";
}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex align-items-center">
                    <i class="bi bi-plus-circle text-primary fs-5 me-2"></i>
                    <h5 class="mb-0 fw-bold">Yeni Makine Ekle</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Ekle" method="post">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Ad" class="form-label">Makine Adı <span class="text-danger">*</span></label>
                                <input asp-for="Ad" class="form-control" placeholder="Örn: Paketleme Makinesi 1" required />
                                <span asp-validation-for="Ad" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Marka" class="form-label">Marka</label>
                                <input asp-for="Marka" class="form-control" placeholder="Örn: Siemens" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label">Model</label>
                                <input asp-for="Model" class="form-control" placeholder="Örn: S7-1200" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SeriNo" class="form-label">Seri No / Kod</label>
                                <input asp-for="SeriNo" class="form-control" placeholder="Örn: SN-2023-XYZ" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Lokasyon" class="form-label">Lokasyon / Departman</label>
                                <div class="input-group">
                                    <select asp-for="Lokasyon" class="form-select" id="lokasyonSelect">
                                        <option value="">-- Seçiniz --</option>
                                        @if (ViewBag.LokasyonKategorileri != null)
                                        {
                                            foreach (var kat in ViewBag.LokasyonKategorileri)
                                            {
                                                <option value="@kat.Ad">@kat.Ad</option>
                                            }
                                        }
                                    </select>
                                    <button class="btn btn-outline-secondary" type="button" onclick="yeniKategoriEkle('MakineLokasyon', 'lokasyonSelect')">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CalismaSaati" class="form-label">Güncel Çalışma Saati (Saat)</label>
                                <div class="input-group">
                                    <input asp-for="CalismaSaati" class="form-control" type="number" min="0" value="0" />
                                    <span class="input-group-text">Saat</span>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Aktif" checked>
                                    <label class="form-check-label" asp-for="Aktif">Sistemde Aktif Mi?</label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top text-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2 hover-lift">İptal</a>
                            <button type="submit" class="btn btn-primary px-4 hover-lift">
                                <i class="bi bi-save me-1"></i> Makineyi Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function yeniKategoriEkle(tur, selectId) {
            var yeniAd = prompt("Yeni kategori adını girin:");
            if (yeniAd) {
                fetch('/api/Kategori', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ ad: yeniAd, tur: tur })
                })
                .then(response => {
                    if (!response.ok) throw new Error('Ekleme başarısız');
                    return response.json();
                })
                .then(data => {
                    var select = document.getElementById(selectId);
                    var option = document.createElement("option");
                    option.text = data.ad;
                    option.value = data.ad;
                    select.add(option);
                    select.value = data.ad;
                    alert("Kategori eklendi: " + data.ad);
                })
                .catch(error => alert("Kategori eklenirken hata oluştu veya zaten mevcut."));
            }
        }
    </script>
}
