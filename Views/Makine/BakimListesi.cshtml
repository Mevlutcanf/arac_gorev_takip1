@model IEnumerable<AracGorevFormu.Models.MakineBakim>

@{
    ViewData["Title"] = "Makine Bakım Geçmişi";
    var makineAd = ViewBag.MakineAd as string;
    var makineId = ViewBag.MakineId;
}

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Makine Yönetimi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bakımlar</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1">@makineAd - Bakım Geçmişi</h2>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="BakimEkle" asp-route-makineId="@makineId" class="btn btn-primary px-4 py-2 hover-lift">
                <i class="bi bi-tools me-2"></i> Yeni Bakım Ekle
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive p-3">
                <table class="table table-hover align-middle mb-0" id="bakimTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0">Tarih</th>
                            <th class="border-0">Bakım Türü</th>
                            <th class="border-0 text-center">Ç. Saati</th>
                            <th class="border-0">Yapılan İşlemler</th>
                            <th class="border-0 text-end">Maliyet</th>
                            <th class="border-0 text-center">Makbuz</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.BakimTarihi.ToString("dd.MM.yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge badge-bakim-turu fs-6">@item.BakimTuru</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-semibold text-muted">@item.CalismaSaati <small>Saat</small></span>
                                </td>
                                <td>
                                    <div class="text-dark">@item.YapilanIslemler</div>
                                    @if (!string.IsNullOrEmpty(item.DegisenParcalar))
                                    {
                                        <div class="small text-muted mt-1"><i class="bi bi-gear-fill me-1 text-secondary"></i> Değişen Parçalar: @item.DegisenParcalar</div>
                                    }
                                </td>
                                <td class="text-end fw-bold @(item.Maliyet > 0 ? "text-danger" : "text-muted")">
                                    @(item.Maliyet > 0 ? item.Maliyet.ToString("C2") : "-")
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.MakbuzDosyaYolu))
                                    {
                                        var makbuzParts = item.MakbuzDosyaYolu.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                        foreach (var part in makbuzParts)
                                        {
                                            if (part.Trim().StartsWith("db:"))
                                            {
                                                var dosyaId = part.Trim().Replace("db:", "");
                                                <a href="@Url.Action("MakbuzIndir", "Makine", new { id = dosyaId })" target="_blank" class="btn btn-sm btn-outline-secondary me-1" title="Makbuzu İndir">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@part.Trim()" target="_blank" class="btn btn-sm btn-outline-secondary me-1" title="Makbuzu Görüntüle">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </a>
                                            }
                                        }
                                    }
                                        @if (!string.IsNullOrEmpty(item.MakbuzMetni))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info ms-1" data-bs-toggle="modal" data-bs-target="#ocrModal-@item.Id" title="Okunan Yazılar (OCR)">
                                                <i class="bi bi-fonts"></i>
                                            </button>
                                            
                                            <!-- OCR Modal -->
                                            <div class="modal fade text-start" id="ocrModal-@item.Id" tabindex="-1" aria-hidden="true">
                                              <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                                <div class="modal-content">
                                                  <div class="modal-header">
                                                    <h5 class="modal-title"><i class="bi bi-robot me-2 text-primary"></i>OCR Makbuz Okuması</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                  </div>
                                                  <div class="modal-body bg-light">
                                                    <pre class="mb-0" style="white-space: pre-wrap; font-family: monospace; font-size: 0.9rem;">@item.MakbuzMetni</pre>
                                                  </div>
                                                </div>
                                              </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                    <form asp-action="BakimSil" asp-route-id="@item.Id" method="post" class="d-inline ms-1" onsubmit="return confirm('Bu bakım kaydını silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-tools text-muted opacity-50 mb-3" style="font-size: 3rem;"></i>
                    <h5 class="text-muted fw-bold">Henüz Bakım Kaydı Yok</h5>
                    <p class="text-muted mb-4">Bu makine için henüz herhangi bir bakım kaydı girilmemiş.</p>
                </div>
            }
        </div>
    </div>

@section Scripts {
    <!-- DataTables Export Buttons Libraries -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            if ($('#bakimTable tbody tr').length > 0 && !$('#bakimTable tbody tr td').hasClass('dataTables_empty')) {
                $('#bakimTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                    },
                    "order": [[0, "desc"]],
                    "pageLength": 25,
                    "dom": '<"d-flex flex-column flex-md-row justify-content-between align-items-center mb-3"Bf>rt<"d-flex flex-column flex-md-row justify-content-between align-items-center mt-3"ip>',
                    "buttons": [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                            className: 'btn btn-success btn-sm me-2',
                            title: 'Makine Bakım Geçmişi',
                            exportOptions: { 
                                columns: [0, 1, 2, 3, 4],
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.toString().replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                            className: 'btn btn-danger btn-sm',
                            title: 'Makine Bakım Geçmişi',
                            orientation: 'portrait',
                            pageSize: 'A4',
                            exportOptions: { 
                                columns: [0, 1, 2, 3, 4],
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.toString().replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                                    }
                                }
                            }
                        }
                    ]
                });
            }
        });
    </script>
}
