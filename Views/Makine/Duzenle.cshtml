@model AracGorevFormu.Models.Makine

@{
    ViewData["Title"] = "Makine Düzenle";
}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex align-items-center">
                    <i class="bi bi-pencil-square text-primary fs-5 me-2"></i>
                    <h5 class="mb-0 fw-bold">Makine Düzenle: @Model.Ad</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Duzenle" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EklenmeTarihi" />
                        
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Ad" class="form-label">Makine Adı <span class="text-danger">*</span></label>
                                <input asp-for="Ad" class="form-control" required />
                                <span asp-validation-for="Ad" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Marka" class="form-label">Marka</label>
                                <input asp-for="Marka" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label">Model</label>
                                <input asp-for="Model" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SeriNo" class="form-label">Seri No / Kod</label>
                                <input asp-for="SeriNo" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Lokasyon" class="form-label">Lokasyon / Departman</label>
                                <select asp-for="Lokasyon" class="form-select">
                                    <option value="">-- Seçiniz --</option>
                                    <option value="Tadıbu">Tadıbu</option>
                                    <option value="Lokum">Lokum</option>
                                    <option value="Helva">Helva</option>
                                    <option value="Depo">Depo</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CalismaSaati" class="form-label">Güncel Çalışma Saati (Saat)</label>
                                <div class="input-group">
                                    <input asp-for="CalismaSaati" class="form-control" type="number" min="0" />
                                    <span class="input-group-text">Saat</span>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Aktif">
                                    <label class="form-check-label" asp-for="Aktif">Sistemde Aktif Mi?</label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top text-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2 hover-lift">İptal</a>
                            <button type="submit" class="btn btn-primary px-4 hover-lift">
                                <i class="bi bi-save me-1"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
