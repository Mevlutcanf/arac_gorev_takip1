@model YeniGorevFormuViewModel
@{
    ViewData["Title"] = "Görev Formu Doldur";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-slate-900 text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-amber-500 bg-opacity-20 rounded-3 text-amber-500 fs-4">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <div>
                        <h1 class="h5 fw-bold mb-1 text-white">Fleon Görev Talebi</h1>
                        <p class="text-white text-opacity-75 small mb-0">Lütfen tüm bilgileri eksiksiz doldurunuz.</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                @if (!Model.AktifAraclar.Any())
                {
                    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <span>Şu anda sistemde kayıtlı aktif araç bulunmuyor. Lütfen yetkili yönetici ile iletişime geçiniz.</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-2 mb-4 bg-blue-50 text-blue-800">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span class="small fw-medium">Yanında kırmızı yıldız (<span class="text-danger">*</span>) bulunan alanların doldurulması zorunludur. Lütfen tarih ve saat seçimlerine dikkat ediniz.</span>
                    </div>
                }

                <form id="yeniGorevForm" asp-controller="Form" asp-action="Yeni" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Step 1: Araç & Kullanan -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-slate-800 text-uppercase tracking-wider fs-7 mb-3 border-bottom pb-2">
                            <i class="bi bi-1-circle-fill text-amber-600 me-1"></i> Araç ve Personel Bilgileri
                        </h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="VehicleId" class="form-label">Kullanılacak Araç <span class="text-danger">*</span></label>
                                <select asp-for="VehicleId" class="form-select form-select-lg fs-6">
                                    <option value="">-- Araç Seçiniz (Plaka - Marka Model) --</option>
                                    @foreach (var arac in Model.AktifAraclar)
                                    {
                                        var disaridaMi = (ViewBag.DisaridakiAracIdleri as List<int>)?.Contains(arac.Id) == true;
                                        var onayBekliyorMu = (ViewBag.OnayBekleyenAracIdleri as List<int>)?.Contains(arac.Id) == true;
                                        
                                        var durumMetni = disaridaMi ? "🔴 Görevde / Dışarıda" : (onayBekliyorMu ? "🟡 Onay Bekliyor" : "🟢 Müsait");
                                        
                                        @if(disaridaMi || onayBekliyorMu)
                                        {
                                            <option value="@arac.Id" disabled>@arac.Plaka — @arac.Marka @arac.Model (@(arac.Renk ?? "Belirtilmedi")) @durumMetni</option>
                                        }
                                        else
                                        {
                                            <option value="@arac.Id">@arac.Plaka — @arac.Marka @arac.Model (@(arac.Renk ?? "Belirtilmedi")) @durumMetni</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="VehicleId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="KullananAdSoyad" class="form-label">Ad Soyad <span class="text-danger">*</span></label>
                                <input asp-for="KullananAdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                                <span asp-validation-for="KullananAdSoyad" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="KullananTelefon" class="form-label">Cep Telefonu <span class="text-danger">*</span></label>
                                <input asp-for="KullananTelefon" class="form-control" placeholder="05XX XXX XX XX" data-mask="phone" />
                                <span asp-validation-for="KullananTelefon" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Departman" class="form-label">Departman / Birim</label>
                                <input asp-for="Departman" class="form-control" placeholder="Örn: Satış, Lojistik, Bilgi İşlem" />
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Görev Detayları -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-slate-800 text-uppercase tracking-wider fs-7 mb-3 border-bottom pb-2">
                            <i class="bi bi-2-circle-fill text-amber-600 me-1"></i> Görev Amacı ve Zamanlama
                        </h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="GorevAmaci" class="form-label">Görev Amacı / Gidilecek Yer <span class="text-danger">*</span></label>
                                <textarea asp-for="GorevAmaci" class="form-control" rows="3" placeholder="Görevin detayını ve varış noktasını açıklayınız..."></textarea>
                                <span asp-validation-for="GorevAmaci" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="CikisZamani" class="form-label">Planlanan Çıkış Tarihi ve Saati <span class="text-danger">*</span></label>
                                <input asp-for="CikisZamani" class="form-control" type="datetime-local" value='@Model.CikisZamani.ToString("yyyy-MM-ddTHH:mm")' />
                                <span asp-validation-for="CikisZamani" class="text-danger small"></span>
                                <div class="form-text text-slate-500 small">Saat ve dakika cinsinden seçiniz.</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <a asp-controller="Form" asp-action="Sorgula" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>Form Sorgula
                        </a>
                        <button type="button" class="btn btn-accent btn-lg px-4" onclick="submitFormWithLoading(this)">
                            <i class="bi bi-send-fill"></i>Görev Formunu Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <style>
        @@keyframes drawCircle { to { stroke-dashoffset: 0; } }
        @@keyframes drawTick   { to { stroke-dashoffset: 0; } }
        #gorevOverlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 2147483647 !important;
            background: rgba(255,255,255,0.3);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            display: none;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
    </style>
    <script>
        // Overlay'i doğrudan body'e ekle (üst eleman transform sorunundan kaçınmak için)
        var overlayEl = document.createElement('div');
        overlayEl.id = 'gorevOverlay';
        overlayEl.innerHTML = `
            <div id="gorevSpinner" style="display:flex;flex-direction:column;align-items:center;text-align:center;">
                <div class="spinner-border" style="width:5rem;height:5rem;border-width:0.4em;color:#f59e0b;" role="status"></div>
                <h3 style="color:#1e293b;font-weight:700;letter-spacing:1px;margin-top:1.5rem;margin-bottom:0.5rem;">Görev Formu Oluşturuluyor...</h3>
                <p style="color:#475569;font-size:1rem;margin:0;">Lütfen sayfayı kapatmayın...</p>
            </div>
            <div id="gorevTick" style="display:none;flex-direction:column;align-items:center;text-align:center;">
                <svg viewBox="0 0 80 80" width="96" height="96">
                    <circle cx="40" cy="40" r="36" fill="none" stroke="#22c55e" stroke-width="5" stroke-dasharray="226" stroke-dashoffset="226" style="animation:drawCircle 0.5s ease forwards;"/>
                    <polyline points="22,42 35,55 58,28" fill="none" stroke="#22c55e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="60" stroke-dashoffset="60" style="animation:drawTick 0.4s ease 0.45s forwards;"/>
                </svg>
                <h3 style="color:#1e293b;font-weight:700;letter-spacing:1px;margin-top:1.2rem;margin-bottom:0.5rem;">Başarıyla Alındı!</h3>
                <p style="color:#16a34a;font-size:1rem;margin:0;">Yönlendiriliyorsunuz...</p>
            </div>
        `;
        document.body.appendChild(overlayEl);

        function submitFormWithLoading(btn) {
            // Overlay'i göster
            overlayEl.style.display = 'flex';
            document.body.style.overflow = 'hidden'; // Scroll'u kilitle

            // Butonu devre dışı bırak
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Gönderiliyor...';
            btn.disabled = true;

            // 1.2sn sonra spinner -> tik
            setTimeout(function () {
                document.getElementById('gorevSpinner').style.display = 'none';
                var tick = document.getElementById('gorevTick');
                tick.style.display = 'flex';
            }, 1200);

            // 2sn sonra formu gönder
            setTimeout(function () {
                document.getElementById('yeniGorevForm').submit();
            }, 2000);
        }
    </script>
}
