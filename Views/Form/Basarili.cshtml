@model GorevFormu
@{
    ViewData["Title"] = "Form Gönderildi";
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8">
        <div class="card shadow-sm border-0 text-center p-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-emerald-100 text-emerald-600 rounded-circle p-3 fs-1" style="width: 72px; height: 72px;">
                    <i class="bi bi-check-lg"></i>
                </div>
            </div>

            <h1 class="h4 fw-bold text-slate-900 mb-2">Görev Formunuz Başarıyla Alındı</h1>
            <p class="text-slate-500 small max-w-md mx-auto mb-3">
                Formunuz yetkili yönetici onayına sunulmuştur. Talebinizi sorgulamak ve araç dönüşünde teslimat bildirmek için aşağıdaki takip kodunu kaydediniz.
            </p>

            <!-- Prominent Gold Highlight Tracking Code -->
            <div class="my-4">
                <div class="tracking-code-badge-container">
                    <span class="tracking-code-title">GÖREV SORGULAMA KODUNUZ</span>
                    <div class="tracking-code-main">@Model.TakipKodu</div>
                </div>
            </div>

            <!-- Form Summary Box -->
            <div class="card bg-slate-50 border-0 p-3 text-start my-4">
                <div class="row g-3">
                    <div class="col-6">
                        <span class="text-slate-500 small d-block">Atanan Araç</span>
                        <span class="plate-chip">@Model.AracPlaka</span>
                        <div class="text-slate-700 small mt-1">@Model.AracMarka @Model.AracModel</div>
                    </div>
                    <div class="col-6">
                        <span class="text-slate-500 small d-block">Kullanan Personel</span>
                        <span class="fw-semibold text-slate-900">@Model.KullananAdSoyad</span>
                        <div class="text-slate-500 small">@Model.KullananTelefon</div>
                    </div>
                    <div class="col-6">
                        <span class="text-slate-500 small d-block">Planlanan Çıkış</span>
                        <span class="fw-semibold text-slate-800">@Model.CikisZamani.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <div class="col-6">
                        <span class="text-slate-500 small d-block">Planlanan Dönüş</span>
                        <span class="fw-semibold text-slate-800">@Model.PlanlananDonusZamani.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-center gap-3">
                <a asp-controller="Form" asp-action="Detay" asp-route-takipKodu="@Model.TakipKodu" class="btn btn-primary">
                    <i class="bi bi-eye me-1"></i>Form Detayını Görüntüle
                </a>
                <a asp-controller="Form" asp-action="Yeni" class="btn btn-outline-secondary">
                    <i class="bi bi-plus-lg me-1"></i>Yeni Form Doldur
                </a>
            </div>
        </div>
    </div>
</div>
