@{
    ViewData["Title"] = "Sayfa Bulunamadı (404)";
    ViewData["MetaDescription"] = "Aradığınız sayfa bulunamadı. Fleon ana sayfasına dönebilirsiniz.";
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="mb-4">
                <i class="bi bi-compass text-primary" style="font-size: 6rem; opacity: 0.8;"></i>
            </div>
            <h1 class="display-1 fw-bold text-slate-800 mb-2">404</h1>
            <h2 class="h3 fw-semibold text-slate-600 mb-4">Kaybolmuş gibisiniz...</h2>
            <p class="lead text-muted mb-5">
                Aradığınız sayfa silinmiş, adı değiştirilmiş veya geçici olarak ulaşılamıyor olabilir. 
                Lütfen URL'yi kontrol edin veya ana sayfaya dönün.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 hover-lift">
                    <i class="bi bi-house-door me-2"></i> Ana Sayfaya Dön
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4 hover-lift">
                    <i class="bi bi-arrow-left me-2"></i> Geri Git
                </a>
            </div>
        </div>
    </div>
</div>
