@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid px-0 py-4">
    <!-- Hero / Intro Section -->
    <div class="row mb-5 mt-4">
        <div class="col-lg-8 mx-auto">
            <div class="card-left-border-accent text-start mb-4 position-relative">
                <i class="bi bi-cursor-fill position-absolute" style="top: -20px; left: -20px; font-size: 3rem; color: var(--primary-color); transform: rotate(-45deg); text-shadow: 0 4px 10px rgba(0,0,0,0.1);"></i>
                <h2 class="mt-2">Kullanışlı Ara Yüz</h2>
                <p class="fs-5 mt-3 mb-4">
                    Kullanıcı dostu ara yüze sahip yazılımlarımızla araçlarınızı kolaylıkla takip edebilir 
                    ve istediğiniz ayarları birkaç tıklamayla halledebilirsiniz. Araç görev takip, bakım hatırlatma,
                    HGS ve ceza sorgulama gibi tüm özellikleri tek ekranda deneyimleyin.
                </p>
                <div class="mt-4 pt-2 border-top border-light">
                    <a asp-controller="Form" asp-action="Yeni" class="btn btn-primary btn-lg rounded-pill px-4 me-2">
                        <i class="bi bi-plus-circle"></i> Görev Formu Doldur
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                        <i class="bi bi-shield-lock"></i> Yönetici Girişi
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Modern Banner Section -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="alert-modern-pastel shadow-sm hover-lift">
                <div class="alert-icon">
                    <i class="bi bi-gear-fill"></i>
                </div>
                <div>
                    <h4>Çağdaş Yazılım</h4>
                    <p>Modern ve kullanıcı dostu arayüz ile kolay filo yönetimi, canlı Arvento araç takibi ve otomatik bakım hatırlatmaları.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Dark Feature Cards Section (Grid) -->
    <div class="row g-4 mt-2 justify-content-center">
        <!-- Belge Takibi -->
        <div class="col-lg-4 col-md-6">
            <div class="feature-card-dark">
                <div class="feature-icon-wrapper bg-light bg-opacity-10 fs-2">
                    📄
                </div>
                <h3>Belgeler</h3>
                <p>Muayene, sigorta, kasko ve ruhsat takibi. Tarihi yaklaşan belgeler için anlık bildirimler ve uyarılar.</p>
                <div class="mt-auto">
                    <i class="bi bi-arrow-right feature-link-arrow"></i>
                </div>
            </div>
        </div>

        <!-- Görevler -->
        <div class="col-lg-4 col-md-6">
            <div class="feature-card-dark">
                <div class="feature-icon-wrapper bg-success bg-opacity-10 text-success fs-2">
                    ✅
                </div>
                <h3>Görevler</h3>
                <p>Ekip görev ve atama yönetimi. Formları dijital ortamda toplayın, yöneticiler tarafından anında onaylansın veya reddedilsin.</p>
                <div class="mt-auto">
                    <i class="bi bi-arrow-right feature-link-arrow"></i>
                </div>
            </div>
        </div>

        <!-- Hatırlatıcılar -->
        <div class="col-lg-4 col-md-6">
            <div class="feature-card-dark">
                <div class="feature-icon-wrapper bg-warning bg-opacity-10 text-warning fs-2">
                    🔔
                </div>
                <h3>Hatırlatıcılar</h3>
                <p>Otomatik bildirim sistemi. Bakımı gelen, muayenesi yaklaşan tüm araçlar için SMTP üzerinden anlık e-posta hatırlatmaları alın.</p>
                <div class="mt-auto">
                    <i class="bi bi-arrow-right feature-link-arrow"></i>
                </div>
            </div>
        </div>

        <!-- Sürücüler -->
        <div class="col-lg-4 col-md-6">
            <div class="feature-card-dark">
                <div class="feature-icon-wrapper bg-primary bg-opacity-10 text-primary fs-2">
                    👨‍✈️
                </div>
                <h3>Sürücüler</h3>
                <p>Belge takibi, zimmetleme ve performans analizi. Hangi aracın kime ait olduğunu ve güncel lokasyonunu görün.</p>
                <div class="mt-auto">
                    <i class="bi bi-arrow-right feature-link-arrow"></i>
                </div>
            </div>
        </div>

        <!-- Seyir Defteri -->
        <div class="col-lg-4 col-md-6">
            <div class="feature-card-dark">
                <div class="feature-icon-wrapper bg-info bg-opacity-10 text-info fs-2">
                    📖
                </div>
                <h3>Seyir Defteri</h3>
                <p>Sefer kayıtları, canlı Arvento GPS verisi ve kilometre analizleri. Tüm filo hareketlerinizi geriye dönük raporlayın.</p>
                <div class="mt-auto">
                    <i class="bi bi-arrow-right feature-link-arrow"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Case Studies / Vaka Çalışmaları Section -->
    <div class="row mt-5 pt-4">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">Vaka Çalışmaları & Başarı Hikayeleri</h2>
            <p class="text-muted fs-5">Sistemimizi kullanan yöneticilerin gerçek kullanım senaryoları.</p>
        </div>
        
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden">
                <div class="row g-0 h-100">
                    <div class="col-md-4 bg-primary bg-opacity-10 d-flex align-items-center justify-content-center p-4">
                        <i class="bi bi-graph-up-arrow text-primary" style="font-size: 4rem;"></i>
                    </div>
                    <div class="col-md-8">
                        <div class="card-body p-4 d-flex flex-column h-100">
                            <h5 class="card-title fw-bold">Zaman Tasarrufu: %40 Artış</h5>
                            <p class="card-text text-muted">
                                "Araçların bakım, muayene ve görev formlarını tek bir havuzda topladığımızdan beri, filomuzu yönetmek için harcadığımız süre yarı yarıya azaldı. Özellikle SMTP hatırlatmaları hayat kurtarıyor."
                            </p>
                            <p class="card-text mt-auto"><small class="text-primary fw-semibold">— Lojistik Operasyon Müdürü</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden">
                <div class="row g-0 h-100">
                    <div class="col-md-4 bg-success bg-opacity-10 d-flex align-items-center justify-content-center p-4">
                        <i class="bi bi-shield-check text-success" style="font-size: 4rem;"></i>
                    </div>
                    <div class="col-md-8">
                        <div class="card-body p-4 d-flex flex-column h-100">
                            <h5 class="card-title fw-bold">Ceza ve HGS Takipleri</h5>
                            <p class="card-text text-muted">
                                "Arvento entegrasyonu sayesinde hangi aracın nerede olduğunu anlık görüyor, gelen HGS geçişleri ve hız cezalarını saniyeler içerisinde doğru sürücüye rücu edebiliyoruz. Kaçak geçişler sıfıra indi."
                            </p>
                            <p class="card-text mt-auto"><small class="text-success fw-semibold">— Filo Şefi</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
