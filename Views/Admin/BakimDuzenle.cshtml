@model AracBakim
@{
    ViewData["Title"] = "Bakım Kaydı Düzenle";
    var araclar = ViewBag.Araclar as List<Vehicle> ?? new List<Vehicle>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-slate-900 text-white d-flex align-items-center justify-content-between py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tools text-amber-500"></i>
                    <span>Bakım / Servis Kaydı Düzenle</span>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="BakimDuzenle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="VehicleId" class="form-label">Araç Seçimi <span class="text-danger">*</span></label>
                            <select asp-for="VehicleId" class="form-select" required>
                                <option value="">-- Araç Seçin --</option>
                                @foreach (var v in araclar)
                                {
                                    <option value="@v.Id">@v.Plaka — @v.Marka @v.Model</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BakimTuru" class="form-label">İşlem Türü <span class="text-danger">*</span></label>
                            <select asp-for="BakimTuru" class="form-select" required>
                                <option value="Periyodik Bakım">Periyodik Bakım</option>
                                <option value="Arıza Onarım">Arıza Onarım</option>
                                <option value="Parça Değişimi">Parça Değişimi</option>
                                <option value="Lastik Değişimi">Lastik Değişimi</option>
                                <option value="Muayene Hazırlık">Muayene Hazırlık</option>
                                <option value="Hasar / Kaza Onarım">Hasar / Kaza Onarım</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BakimTarihi" class="form-label">Bakım Tarihi <span class="text-danger">*</span></label>
                            <input asp-for="BakimTarihi" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Km" class="form-label">Servise Giriş Km <span class="text-danger">*</span></label>
                            <input asp-for="Km" type="number" class="form-control" required min="0" />
                        </div>

                        <div class="col-12">
                            <label asp-for="YapilanIslemler" class="form-label">Yapılan İşlemler / Detaylar <span class="text-danger">*</span></label>
                            <textarea asp-for="YapilanIslemler" class="form-control" rows="3" required placeholder="Örn: Motor yağı ve filtreler değişti, balatalar yenilendi..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ServisAdi" class="form-label">Servis / Usta Adı</label>
                            <input asp-for="ServisAdi" class="form-control" placeholder="Servis bilgisi" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Maliyet" class="form-label">Maliyet (₺) <span class="text-danger">*</span></label>
                            <input asp-for="Maliyet" type="number" step="0.01" class="form-control" required min="0" />
                        </div>

                        <div class="col-12 mt-4 mb-2">
                            <h6 class="fw-bold text-slate-700 border-bottom pb-2"><i class="bi bi-calendar-plus me-1"></i>Sonraki Bakım Planlaması (Opsiyonel)</h6>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SonrakiBakimKm" class="form-label">Sonraki Bakım Km</label>
                            <input asp-for="SonrakiBakimKm" type="number" class="form-control" min="0" placeholder="Örn: 150000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SonrakiBakimTarihi" class="form-label">Sonraki Bakım Tarihi</label>
                            <input asp-for="SonrakiBakimTarihi" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Bakimlar" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
