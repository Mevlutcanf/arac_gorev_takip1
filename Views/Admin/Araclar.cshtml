@model List<Vehicle>
@{
    ViewData["Title"] = "Araç Filosu";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 fw-bold text-slate-900 mb-1">
            <i class="bi bi-car-front-fill text-indigo-600 me-2"></i>Şirket Araç Filosu & Ruhsat Yönetimi
        </h1>
        <p class="text-slate-500 small mb-0">Filoda tanımlı araçlar, ruhsat evrakları, sahiplik (öz mal / kiralık), zimmetli personel ve muayene takibi.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Bakimlar" class="btn btn-outline-primary">
            <i class="bi bi-tools me-1"></i>Bakım Geçmişi
        </a>
        <a asp-action="HgsBorc" class="btn btn-outline-secondary">
            <i class="bi bi-credit-card-2-front me-1"></i>HGS Borç Sorgula
        </a>
        <a asp-action="AracEkle" class="btn btn-warning text-dark fw-bold">
            <i class="bi bi-plus-lg me-1"></i>Yeni Araç Ekle
        </a>
    </div>
</div>

<div class="card shadow-sm border">
    <div class="p-3">
        <table class="table align-middle mb-0 dt-responsive nowrap" id="araclarTable" style="width:100%">
            <thead>
                <tr>
                    <th class="ps-3 text-nowrap">Plaka / Sahiplik</th>
                    <th class="text-nowrap">Marka / Model</th>
                    <th style="min-width: 200px;">Zimmetli Sürücü / Lokasyon</th>
                    <th class="text-nowrap">Canlı Durum (Arvento)</th>
                    <th class="text-nowrap">Muayene & Sigorta</th>
                    <th class="text-nowrap">Ruhsat Belgesi</th>
                    <th class="text-nowrap">Durum</th>
                    <th class="text-end pe-3 text-nowrap all">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var arac in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="plate-chip mb-1">@arac.Plaka</div>
                            <div>
                                @if (arac.SahiplikTuru == "Kiralık Araç")
                                {
                                    <span class="badge badge-kiralik">
                                        <i class="bi bi-key-fill me-1"></i>Kiralık Araç
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-sahiplik badge-sirket">
                                        <i class="bi bi-building-check me-1"></i>Şirket Aracı
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-slate-900 fs-6">@arac.Marka @arac.Model</div>
                            <div class="text-slate-500 extra-small">@(arac.Renk ?? "Renk Belirtilmedi")</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(arac.SabitSurucu))
                            {
                                <div class="fw-bold text-indigo-900 small"><i class="bi bi-person-badge me-1"></i>@arac.SabitSurucu</div>
                            }
                            else
                            {
                                <div class="text-slate-500 small"><i class="bi bi-people me-1"></i>Ortak Havuz Aracı</div>
                            }
                            <div class="text-slate-500 extra-small"><i class="bi bi-geo-alt me-1"></i>@(arac.Lokasyon ?? "Genel Merkez")</div>
                        </td>
                        <td>
                            @if (arac.SonKonumZamani.HasValue)
                            {
                                <div class="small fw-bold text-slate-800" style="white-space: normal; max-width: 200px;"><i class="bi bi-geo-fill text-danger me-1"></i>@(arac.SonAdres ?? "Adres Bilinmiyor")</div>
                                <div class="extra-small text-slate-500 mt-1"><i class="bi bi-clock me-1"></i>@arac.SonKonumZamani.Value.ToString("dd.MM.yyyy HH:mm")</div>
                                @if(arac.GuncelKm.HasValue)
                                {
                                    <div class="extra-small text-slate-600 fw-semibold"><i class="bi bi-speedometer2 me-1"></i>@arac.GuncelKm.Value KM</div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border"><i class="bi bi-wifi-off me-1"></i>Arvento Verisi Yok</span>
                            }
                        </td>
                        <td>
                            @if (arac.MuayeneBitisTarihi != null)
                            {
                                var gun = (arac.MuayeneBitisTarihi.Value - DateTime.Now).Days;
                                <div class="fw-bold extra-small @(gun < 30 ? "text-danger bg-red-50 p-1 rounded border border-danger border-opacity-25" : "text-slate-800") mb-1">
                                    <i class="bi bi-calendar-event me-1"></i>Muayene: @arac.MuayeneBitisTarihi.Value.ToString("dd.MM.yyyy")
                                </div>
                            }
                            @if (arac.SigortaBitisTarihi != null)
                            {
                                var gun = (arac.SigortaBitisTarihi.Value - DateTime.Now).Days;
                                <div class="fw-bold extra-small @(gun < 30 ? "text-danger bg-red-50 p-1 rounded border border-danger border-opacity-25" : "text-slate-600")">
                                    <i class="bi bi-shield-check me-1"></i>Sigorta: @arac.SigortaBitisTarihi.Value.ToString("dd.MM.yyyy")
                                </div>
                            }
                        </td>
                        <td>
                            @if (arac.RuhsatDosyaIcerigi != null && arac.RuhsatDosyaIcerigi.Length > 0)
                            {
                                <a href="@Url.Action("RuhsatDosyaIndir", "Admin", new { id = arac.Id })" target="_blank" class="badge badge-ruhsat-var text-decoration-none">
                                    <i class="bi bi-file-earmark-check me-1"></i>Ruhsat Yüklü
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(arac.RuhsatDosyaYolu))
                            {
                                <a href="@arac.RuhsatDosyaYolu" target="_blank" class="badge badge-ruhsat-var text-decoration-none">
                                    <i class="bi bi-file-earmark-check me-1"></i>Ruhsat Yüklü
                                </a>
                            }
                            else
                            {
                                <span class="badge badge-ruhsat-yok">Yüklenmedi</span>
                            }
                        </td>
                        <td>
                            @if (arac.Aktif)
                            {
                                <span class="badge badge-aktif">
                                    <i class="bi bi-check-circle me-1"></i>Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-pasif">
                                    <i class="bi bi-dash-circle me-1"></i>Pasif
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="Bakimlar" asp-route-vehicleId="@arac.Id" class="btn btn-outline-amber btn-sm" data-bs-toggle="tooltip" title="Bakım Geçmişi">
                                    <i class="bi bi-tools"></i>
                                </a>
                                <a asp-action="HgsBorc" asp-route-plaka="@arac.Plaka" class="btn btn-outline-indigo btn-sm" data-bs-toggle="tooltip" title="HGS Borç Sorgula">
                                    <i class="bi bi-credit-card-2-front"></i>
                                </a>
                                <a asp-action="AracDetay" asp-route-id="@arac.Id" class="btn btn-sm btn-outline-primary" title="Araç Detaylarını Görüntüle">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="AracDuzenle" asp-route-id="@arac.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="AracSil" asp-route-id="@arac.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu aracı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-slate-400">Filoda kayıtlı araç bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- DataTables Export Buttons Libraries -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            if ($('#araclarTable tbody tr td').length > 1) {
                $('#araclarTable').DataTable({
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json' },
                    pageLength: 25,
                    responsive: true,
                    ordering: true,
                    dom: '<"d-flex flex-column flex-md-row justify-content-between align-items-center mb-3"Bf>rt<"d-flex flex-column flex-md-row justify-content-between align-items-center mt-3"ip>',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                            className: 'btn btn-warning btn-sm text-dark fw-bold me-2',
                            title: 'Arac Filosu Listesi',
                            exportOptions: { 
                                columns: [0, 1, 2, 3, 4, 5],
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.toString().replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                            className: 'btn btn-danger btn-sm',
                            title: 'Arac Filosu Listesi',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: { 
                                columns: [0, 1, 2, 3, 4, 5],
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.toString().replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                                    }
                                }
                            }
                        }
                    ]
                });
            }
        });
    </script>
}
