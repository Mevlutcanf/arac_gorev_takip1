@model RedViewModel
@{
    ViewData["Title"] = "Formu Reddet";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-x-circle" style="color: #ef4444;"></i>
                <span>Görev Formunu Reddet</span>
            </div>
            <div class="card-body">
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>Bu işlem geri alınamaz. Lütfen ret nedenini belirtiniz.
                </div>
                <form asp-action="FormReddet" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FormId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="RedNedeni" class="form-label"><i class="bi bi-chat-text me-1"></i>Ret Nedeni</label>
                        <textarea asp-for="RedNedeni" class="form-control" rows="4" placeholder="Reddetme nedenini kısaca açıklayınız"></textarea>
                        <span asp-validation-for="RedNedeni" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Reddet</button>
                        <a asp-action="Formlar" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
