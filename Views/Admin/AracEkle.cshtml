@model Vehicle
@{
    ViewData["Title"] = "Yeni Araç Ekle";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-slate-900 text-white d-flex align-items-center gap-2">
                <i class="bi bi-car-front-fill text-amber-500"></i>
                <span>Filoya Yeni Araç Tanımla</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="AracEkle" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Temel Bilgiler -->
                    <h6 class="fw-bold text-slate-900 mb-3 border-bottom pb-2">
                        <i class="bi bi-info-circle me-1 text-slate-600"></i>Temel Araç Bilgileri
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Plaka" class="form-label">Araç Plakası <span class="text-danger">*</span></label>
                            <input asp-for="Plaka" class="form-control font-monospace fw-bold" placeholder="06 AB 123" />
                            <span asp-validation-for="Plaka" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SahiplikTuru" class="form-label">Sahiplik Türü <span class="text-danger">*</span></label>
                            <select asp-for="SahiplikTuru" class="form-select">
                                <option value="Şirket Öz Malı">🏢 Şirket Öz Malı</option>
                                <option value="Kiralık Araç">🔑 Kiralık Araç (Rent a Car)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Marka" class="form-label">Marka <span class="text-danger">*</span></label>
                            <input asp-for="Marka" class="form-control" placeholder="Ford, VW, Renault..." />
                            <span asp-validation-for="Marka" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Model" class="form-label">Model <span class="text-danger">*</span></label>
                            <input asp-for="Model" class="form-control" placeholder="Transit, Caddy, Clio..." />
                            <span asp-validation-for="Model" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Renk" class="form-label">Renk</label>
                            <input asp-for="Renk" class="form-control" placeholder="Beyaz, Siyah..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Lokasyon" class="form-label">Araç Bulunduğu Şehir / Lokasyon</label>
                            <input asp-for="Lokasyon" class="form-control" placeholder="Ankara Genel Merkez, İstanbul Şube..." />
                        </div>
                        <div class="col-12">
                            <label asp-for="SabitSurucu" class="form-label">Zimmetli / Sabit Personel (Şahsa Özel Atama)</label>
                            <input asp-for="SabitSurucu" class="form-control" placeholder="Örn: Ahmet Yılmaz (İstanbul Bölge Satış Müdürü)" />
                            <div class="form-text extra-small text-slate-500">Araç belirli bir uzaktan çalışan personele veya şahsa özel tahsis edildiyse adını yazınız.</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="Aktif" class="form-check-input" type="checkbox" id="aktifEkleSwitch" checked />
                                <label class="form-check-label fw-semibold" for="aktifEkleSwitch">Araç Görev İçin Aktif Kullanımda</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Araclar" class="btn btn-outline-secondary">Vazgeç</a>
                        <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Aracı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
