@model List<GorevFormu>
@{
    ViewData["Title"] = "Görev Formları";
    string? seciliDurum = ViewBag.SeciliDurum;
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold text-slate-900 mb-1">Tüm Görev Formları</h1>
        <p class="text-slate-500 small mb-0">Sistemde oluşturulan tüm araç görev talepleri ve durum geçmişi.</p>
    </div>
    <div class="d-flex gap-1 bg-slate-200 p-1 rounded-3">
        <a asp-action="Formlar" class="btn btn-sm @(seciliDurum == null ? "btn-white shadow-sm text-slate-900 fw-bold" : "text-slate-600")">
            <i class="bi bi-list-task me-1"></i>Tümü
        </a>
        <a asp-action="Formlar" asp-route-durum="Beklemede" class="btn btn-sm @(seciliDurum == "Beklemede" ? "btn-white shadow-sm text-amber-600 fw-bold" : "text-slate-600")">
            <i class="bi bi-hourglass-split me-1"></i>Bekleyen
        </a>
        <a asp-action="Formlar" asp-route-durum="Onaylandi" class="btn btn-sm @(seciliDurum == "Onaylandi" ? "btn-white shadow-sm text-blue-600 fw-bold" : "text-slate-600")">
            <i class="bi bi-arrow-up-right-circle-fill me-1"></i>Onaylı
        </a>
        <a asp-action="Formlar" asp-route-durum="TamamlandiDondu" class="btn btn-sm @(seciliDurum == "TamamlandiDondu" ? "btn-white shadow-sm text-emerald-600 fw-bold" : "text-slate-600")">
            <i class="bi bi-check-circle-fill me-1"></i>Tamamlanan
        </a>
        <a asp-action="Formlar" asp-route-durum="Reddedildi" class="btn btn-sm @(seciliDurum == "Reddedildi" ? "btn-white shadow-sm text-red-600 fw-bold" : "text-slate-600")">
            <i class="bi bi-x-circle-fill me-1"></i>Reddedilen
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="formlarTable">
            <thead>
                <tr>
                    <th>Takip Kodu</th>
                    <th>Araç Bilgisi</th>
                    <th>Kullanan Personel</th>
                    <th>Çıkış Tarihi</th>
                    <th>Planlanan Dönüş</th>
                    <th>Durum</th>
                    <th class="text-end no-print">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var form in Model)
                {
                    <tr class="cursor-pointer hover-lift-row" onclick="window.location.href='@Url.Action("FormDetay", new { id = form.Id })'">
                        <td>
                            <span class="font-monospace fw-bold text-amber-600">@form.TakipKodu</span>
                        </td>
                        <td>
                            <span class="plate-chip">@form.AracPlaka</span>
                            <div class="text-slate-500 small mt-1">@form.AracMarka @form.AracModel</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-slate-900">@form.KullananAdSoyad</div>
                            <div class="text-slate-500 small">@form.KullananTelefon</div>
                        </td>
                        <td>
                            <div class="text-slate-700">@form.CikisZamani.ToString("dd.MM.yyyy")</div>
                            <div class="text-slate-500 small">@form.CikisZamani.ToString("HH:mm")</div>
                        </td>
                        <td>
                            <div class="text-slate-700">@form.PlanlananDonusZamani.ToString("dd.MM.yyyy")</div>
                            <div class="text-slate-500 small">@form.PlanlananDonusZamani.ToString("HH:mm")</div>
                        </td>
                        <td>
                            @if (form.Durum == GorevDurumu.Beklemede)
                            {
                                <span class="badge-status badge-pending"><span class="badge-status-dot"></span>Onay Bekliyor</span>
                            }
                            else if (form.Durum == GorevDurumu.Onaylandi && form.GercekDonusZamani == null)
                            {
                                <span class="badge-status badge-approved"><span class="badge-status-dot"></span>Araç Dışarıda</span>
                            }
                            else if (form.Durum == GorevDurumu.TamamlandiDondu)
                            {
                                <span class="badge-status badge-completed"><span class="badge-status-dot"></span>Tamamlandı</span>
                            }
                            else if (form.Durum == GorevDurumu.Reddedildi)
                            {
                                <span class="badge-status badge-rejected"><span class="badge-status-dot"></span>Reddedildi</span>
                            }
                        </td>
                        <td class="text-end no-print" onclick="event.stopPropagation();">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="FormDetay" asp-route-id="@form.Id" class="btn btn-outline-secondary btn-sm" data-bs-toggle="tooltip" title="Detay">
                                    <i class="bi bi-eye"></i>Detay
                                </a>
                                @if (form.Durum == GorevDurumu.Beklemede)
                                {
                                    <form asp-action="FormOnayla" asp-route-id="@form.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm" data-bs-toggle="tooltip" title="Onayla"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                    <a asp-action="FormReddet" asp-route-id="@form.Id" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" title="Reddet"><i class="bi bi-x-lg"></i></a>
                                }
                                @if (form.AracDisarida)
                                {
                                    <form asp-action="FormDonusIsaretle" asp-route-id="@form.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-sm" data-bs-toggle="tooltip" title="Araç Döndü"><i class="bi bi-box-arrow-in-left"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-slate-400">Aranan filtrelere uygun görev formu kaydı bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .hover-lift-row {
        transition: all 0.2s ease;
    }
    .hover-lift-row:hover {
        background-color: #f1f5f9 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        z-index: 10;
        position: relative;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

@section Scripts {
    <!-- DataTables Export Buttons Libraries -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            if ($('#formlarTable tbody tr td').length > 1) {
                $('#formlarTable').DataTable({
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json' },
                    pageLength: 25,
                    responsive: true,
                    ordering: true,
                    order: [[3, 'desc']], // Çıkış tarihine göre azalan
                    dom: '<"d-flex flex-column flex-md-row justify-content-between align-items-center mb-3"Bf>rt<"d-flex flex-column flex-md-row justify-content-between align-items-center mt-3"ip>',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                            className: 'btn btn-success btn-sm',
                            title: 'Gorev Formlari',
                            exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                            className: 'btn btn-danger btn-sm',
                            title: 'Gorev Formlari',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                        }
                    ]
                });
            }
        });
    </script>
}
