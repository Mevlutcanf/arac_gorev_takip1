@model List<AracBakim>
@{
    ViewData["Title"] = "Araç Bakım & Servis Takibi";
    var araclar = ViewBag.Araclar as List<Vehicle> ?? new List<Vehicle>();
    int? seciliVehicleId = ViewBag.SeciliVehicleId as int?;
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold text-slate-900 mb-1">
            <i class="bi bi-tools text-amber-500 me-2"></i>Araç Bakım & Servis Takibi
        </h1>
        <p class="text-slate-500 small mb-0">Filodaki araçların periyodik bakımları, değişen parçaları, tamir ve km takip kayıtları.</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>Yazdır
        </button>
        <button type="button" class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#yeniBakimModal">
            <i class="bi bi-plus-lg me-1"></i>Yeni Bakım Kaydı Ekle
        </button>
    </div>
</div>

<div class="card shadow-sm border mb-4">
    <div class="card-header bg-slate-900 text-white d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-list-stars text-amber-500"></i>
            <span>Servis Geçmişi ve Planlanan Bakımlar</span>
        </div>
        <div>
            <form method="get" asp-action="Bakimlar" class="row g-2 align-items-center m-0">
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-slate-800 text-slate-400 border-slate-700"><i class="bi bi-calendar3"></i></span>
                        <input type="date" name="baslangicTarihi" class="form-control bg-slate-800 text-white border-slate-700" value="@ViewBag.BaslangicTarihi" title="Başlangıç Tarihi" onchange="this.form.submit()" />
                        <span class="input-group-text bg-slate-800 text-slate-400 border-slate-700 border-start-0 border-end-0">-</span>
                        <input type="date" name="bitisTarihi" class="form-control bg-slate-800 text-white border-slate-700" value="@ViewBag.BitisTarihi" title="Bitiş Tarihi" onchange="this.form.submit()" />
                    </div>
                </div>
                <div class="col-auto">
                    <select name="vehicleId" class="form-select form-select-sm bg-slate-800 text-white border-slate-700" onchange="this.form.submit()">
                        <option value="">-- Tüm Araçlar --</option>
                        @foreach (var v in araclar)
                        {
                            <option value="@v.Id" selected="@(seciliVehicleId == v.Id)">@v.Plaka — @v.Marka @v.Model</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <a asp-action="Bakimlar" class="btn btn-sm btn-outline-secondary" title="Filtreleri Temizle">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
    <div class="table-responsive p-3">
        <table class="table align-middle mb-0" id="bakimlarTable">
            <thead>
                <tr>
                    <th class="ps-3">Plaka / Araç</th>
                    <th>Bakım Türü</th>
                    <th>Bakım Tarihi</th>
                    <th>Servis Km</th>
                    <th>Yapılan İşlemler</th>
                    <th>Servis Adı</th>
                    <th>Maliyet</th>
                    <th>Sonraki Bakım</th>
                    <th class="text-end pe-3 no-print">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <span class="plate-chip">@b.Plaka</span>
                        </td>
                        <td>
                            <span class="badge badge-bakim-turu">
                                <i class="bi bi-wrench me-1"></i>@b.BakimTuru
                            </span>
                        </td>
                        <td class="fw-semibold text-slate-800">@b.BakimTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="font-monospace text-slate-700">@b.Km.ToString("N0") km</td>
                        <td class="text-slate-800 small max-w-xs">@b.YapilanIslemler</td>
                        <td class="text-slate-600 small">@(b.ServisAdi ?? "—")</td>
                        <td class="fw-bold text-slate-900">@b.Maliyet.ToString("C2")</td>
                        <td class="small">
                            @if (b.SonrakiBakimTarihi != null)
                            {
                                <div class="text-emerald-700 fw-semibold"><i class="bi bi-calendar-check me-1"></i>@b.SonrakiBakimTarihi.Value.ToString("dd.MM.yyyy")</div>
                            }
                            @if (b.SonrakiBakimKm != null)
                            {
                                <div class="text-slate-500 font-monospace extra-small">@b.SonrakiBakimKm.Value.ToString("N0") km</div>
                                var guncelArac = araclar.FirstOrDefault(x => x.Id == b.VehicleId);
                                @if (guncelArac != null && guncelArac.GuncelKm > 0)
                                {
                                    var kalanKm = b.SonrakiBakimKm.Value - guncelArac.GuncelKm;
                                    if (kalanKm <= 0)
                                    {
                                        <div class="mt-1 badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Bakım Geçti!</div>
                                    }
                                    else if (kalanKm <= 1000)
                                    {
                                        <div class="mt-1 badge bg-warning text-dark"><i class="bi bi-exclamation-circle-fill me-1"></i>Yaklaştı (@kalanKm km)</div>
                                    }
                                }
                            }
                        </td>
                        <td class="text-end pe-3 no-print">
                            <a asp-action="BakimDuzenle" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary" title="Detay / Düzenle">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="BakimSil" method="post" class="d-inline" onsubmit="return confirm('Bu bakım kaydını silmek istediğinize emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-slate-400">Henüz bakım kaydı bulunmuyor.</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th class="text-end pe-3 fw-bold">Genel Toplam:</th>
                    <th id="totalMaliyet" class="fw-bold text-slate-900">0,00 ₺</th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Modal: Yeni Bakım Kaydı -->
<div class="modal fade" id="yeniBakimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-slate-900 text-white">
                <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-tools text-amber-500 me-2"></i>Yeni Araç Bakım Kaydı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="BakimEkle" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Araç Seçimi <span class="text-danger">*</span></label>
                            <select name="VehicleId" class="form-select" required>
                                <option value="">-- Araç Seçiniz --</option>
                                @foreach (var v in araclar)
                                {
                                    <option value="@v.Id">@v.Plaka — @v.Marka @v.Model</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Bakım Türü <span class="text-danger">*</span></label>
                            <select name="BakimTuru" class="form-select" required>
                                <option value="Periyodik Yağ Bakımı">Periyodik Yağ Bakımı</option>
                                <option value="Fren & Lastik Değişimi">Fren & Lastik Değişimi</option>
                                <option value="Trafik Muayenesi">Trafik Muayenesi</option>
                                <option value="Ağır Bakım / Triger">Ağır Bakım / Triger</option>
                                <option value="Arıza / Onarım">Arıza / Onarım</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Bakım Tarihi <span class="text-danger">*</span></label>
                            <input name="BakimTarihi" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Bakım Anındaki Km <span class="text-danger">*</span></label>
                            <input name="Km" type="number" class="form-control" placeholder="Örn: 45000" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Yapılan İşlemler ve Değişen Parçalar <span class="text-danger">*</span></label>
                            <textarea name="YapilanIslemler" class="form-control" rows="3" placeholder="Motor yağı, filtreler, fren balatası vb..." required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Servis / Tamirhane Adı</label>
                            <input name="ServisAdi" type="text" class="form-control" placeholder="Yetkili veya Özel Servis Adı" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Toplam Maliyet (TL)</label>
                            <input name="Maliyet" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sonraki Tahmini Bakım Tarihi</label>
                            <input name="SonrakiBakimTarihi" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sonraki Bakım Km</label>
                            <input name="SonrakiBakimKm" type="number" class="form-control" placeholder="Örn: 60000" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-slate-50">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-accent px-4"><i class="bi bi-save me-1"></i>Bakım Kaydını Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables Export Buttons Libraries -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            // Modal'ı body'nin en altına taşı, böylece backdrop (kararma) sorunu çözülür
            $('#yeniBakimModal').appendTo('body');

            // Sadece tablo satırı varsa DataTables'ı başlat
            if ($('#bakimlarTable tbody tr td').length > 1) {
                $('#bakimlarTable').DataTable({
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json' },
                    pageLength: 25,
                    responsive: true,
                    ordering: true,
                    dom: '<"d-flex flex-column flex-md-row justify-content-between align-items-center mb-3"Bf>rt<"d-flex flex-column flex-md-row justify-content-between align-items-center mt-3"ip>',
                    footerCallback: function (row, data, start, end, display) {
                        var api = this.api();

                        // String değerleri (1.500,00 ₺ gibi) sayıya çeviren fonksiyon
                        var intVal = function (i) {
                            if (typeof i === 'string') {
                                return i.replace(/[\₺\.]/g, '').replace(',', '.') * 1;
                            }
                            return typeof i === 'number' ? i : 0;
                        };

                        // Mevcut sayfadaki toplam maliyeti hesapla
                        var pageTotal = api
                            .column(6, { page: 'current' })
                            .data()
                            .reduce(function (a, b) {
                                return intVal(a) + intVal(b);
                            }, 0);

                        // Toplamı Türkçe para formatında tfoot'a yaz
                        var formatter = new Intl.NumberFormat('tr-TR', {
                            style: 'currency',
                            currency: 'TRY',
                            minimumFractionDigits: 2
                        });
                        $(api.column(6).footer()).html(formatter.format(pageTotal));
                    },
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                            className: 'btn btn-success btn-sm me-2',
                            title: 'Arac Bakim Raporu',
                            footer: true,
                            messageBottom: function() {
                                return 'Genel Toplam: ' + $('#totalMaliyet').text();
                            },
                            exportOptions: {
                                columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.toString().replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                            className: 'btn btn-danger btn-sm',
                            title: 'Arac Bakim Raporu',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            footer: true,
                            messageBottom: function() {
                                return 'Genel Toplam: ' + $('#totalMaliyet').text();
                            },
                            exportOptions: {
                                columns: [0, 1, 2, 3, 4, 5, 6, 7],
                                format: {
                                    body: function (data, row, column, node) {
                                        return data.toString().replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                                    }
                                }
                            },
                            customize: function(doc) {
                                doc.defaultStyle.fontSize = 9;
                                doc.styles.tableHeader.fontSize = 10;
                                doc.styles.tableFooter.fontSize = 10;
                                doc.styles.tableFooter.bold = true;
                            }
                        }
                    ]
                });
            }
        });
    </script>
}
