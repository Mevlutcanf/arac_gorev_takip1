@model LoginViewModel
@{
    ViewData["Title"] = "Yönetici Girişi";
    Layout = "_Layout";
}

<div class="row justify-content-center py-5">
    <div class="col-xl-4 col-lg-5 col-md-7">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-slate-900 text-white text-center p-4">
                <div class="app-brand-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h1 class="h5 fw-bold text-white mb-1">Yönetici Paneli Girişi</h1>
                <p class="text-slate-400 small mb-0">Abdurrahman Tatlıcı Araç Takip Sistemi</p>
            </div>

            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.HataMesaji))
                {
                    <div class="alert alert-danger border-0 small mb-4">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>@Model.HataMesaji
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="KullaniciAdi" class="form-label">Kullanıcı Adı</label>
                        <div class="input-group">
                            <span class="input-group-text bg-slate-50 border-end-0 text-slate-500"><i class="bi bi-person"></i></span>
                            <input asp-for="KullaniciAdi" class="form-control border-start-0 ps-0" placeholder="admin" autofocus />
                        </div>
                        <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Sifre" class="form-label">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-slate-50 border-end-0 text-slate-500"><i class="bi bi-key"></i></span>
                            <input asp-for="Sifre" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i>Sisteme Giriş Yap
                        </button>
                    </div>
                </form>

                <div class="mt-4 pt-3 border-top text-center">
                    <span class="text-slate-400 extra-small">Varsayılan Kimlik: <code class="text-slate-700 fw-bold">admin</code> / <code class="text-slate-700 fw-bold">Admin123!</code></span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
