@model LoginViewModel
@{
    ViewData["Title"] = "Yönetici Girişi";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - Fleon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <!-- Left Side: Graphic / Info -->
        <div class="login-left">
            <div class="login-left-content">
                <div class="mx-auto mb-4" style="width:120px; height:120px;">
                    <img src="~/img/fleon-logo.jpg" alt="Fleon Logo" style="width:120px; height:120px; border-radius:16px; object-fit:contain; box-shadow: 0 10px 25px rgba(0,0,0,0.1);" />
                </div>
                <h2 class="fw-bold mb-3" style="color: #0f172a; font-size:2.5rem; letter-spacing:-1px;">Fleon</h2>
                <h4 class="fw-medium mb-3" style="color: #334155;">Filo ve Makine Zekası</h4>
                <p class="text-slate-600 mb-0">Aracınızın görevlerini, makine bakım süreçlerini ve HGS harcamalarını tek ekrandan modern ve akıcı bir arayüzle kontrol edin.</p>
                
                <div class="mt-5 p-4 rounded-4" style="background: rgba(255,255,255,0.5); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.7);">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span class="fw-semibold text-slate-800">Canlı Arvento Entegrasyonu</span>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span class="fw-semibold text-slate-800">Akıllı Bakım Hatırlatmaları</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span class="fw-semibold text-slate-800">Hızlı Görev Atamaları</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="login-right">
            <div class="login-right-inner">
                <div class="text-center mb-5">
                    <h1 class="h3 fw-bold mb-2">Devam etmek için giriş yapın</h1>
                    <p class="text-slate-500">Hoş geldiniz! Lütfen detaylarınızı girin.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.HataMesaji))
                {
                    <div class="alert alert-danger border-0 small mb-4 rounded-3 d-flex align-items-center">
                        <i class="bi bi-exclamation-circle-fill fs-5 me-2"></i>
                        <div>@Model.HataMesaji</div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="KullaniciAdi" class="form-label">Kullanıcı Adı</label>
                        <input asp-for="KullaniciAdi" class="form-control form-control-lg" placeholder="ornek_kullanici" autofocus />
                        <span asp-validation-for="KullaniciAdi" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Sifre" class="form-label">Şifre</label>
                        <input asp-for="Sifre" class="form-control form-control-lg" placeholder="••••••••" />
                        <span asp-validation-for="Sifre" class="text-danger small mt-1 d-block"></span>
                        <div class="mt-2 text-end">
                            <a href="#" onclick="alert('Lütfen şifrenizi sıfırlamak için ana yönetici ile iletişime geçin.'); return false;" class="text-decoration-none text-primary small fw-semibold">Şifrenizi mi unuttunuz?</a>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label text-slate-600 fw-medium text-sm" for="rememberMe">
                            Beni hatırla
                        </label>
                    </div>

                    <div class="d-grid mt-2 gap-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 shadow-sm hover-lift">
                            Giriş Yap
                        </button>
                        <a asp-controller="Form" asp-action="Yeni" class="btn btn-outline-secondary btn-lg rounded-pill py-3 hover-lift">
                            <i class="bi bi-card-checklist me-2"></i>Giriş Yapmadan Görev Formu Doldur
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
